{
  "name": "wms-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
 "scripts": {
  "dev": "node --experimental-sqlite src/server.js",
  "seed": "node --experimental-sqlite src/db/seed.js",
